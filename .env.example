# Server-side settings read by api/report.js.
# Copy to .env.local for local development. Set in Vercel Project Settings
# > Environment Variables when using different gateways, then redeploy.
# These values are also the defaults when variables are omitted.

# Call records and daily productivity reports.
OZONETEL_REPORT_URL=https://agent-productivity-dashboard.vercel.app/api/report

# Agent state and mode summaries (including idle time).
OZONETEL_STATES_URL=https://agent-break-dashboard-live.vercel.app/api/report

# Live and historical named breaks from September 26, 2026 onward.
OZONETEL_BREAKS_URL=https://agent-break-dashboard-live.vercel.app/api/today-breaks

# Saved break snapshots for earlier dates.
OZONETEL_SAVED_BREAKS_URL=https://agent-break-dashboard-live.vercel.app/api/breaks

# API keys required by THIS repository: none.
# Ozonetel credentials are managed by the upstream gateway deployments, whose
# source is not included here. This app does not read OZONETEL_API_KEY or Zoho keys.
# Gateway URLs must return the existing JSON contracts; a raw Ozonetel endpoint
# is not a drop-in replacement. This app currently sends no auth header upstream.
# WhatsApp is a layout placeholder; no WhatsApp API integration is implemented.
# GitHub/Vercel CLI credentials are separate login credentials, not app env vars.
# Never put real credentials in this example or commit .env.local.
